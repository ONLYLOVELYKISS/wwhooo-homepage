{
  "name": "wwhooo-homepage",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "wwhooo.com personal homepage — static site built with Vite, served by Nginx.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-routes.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9",
    "vite": "^7.1.9"
  }
}
